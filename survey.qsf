5,6],"Choices":{"1":{"Display":"Two years"},"2":{"Display":"Four years"},"3":{"Display":"Six years"},"4":{"Display":"Eight years"},"5":{"Display":"None of these"},"6":{"Display":"Don't know"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"pk1","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":7,"QuestionDescription":"For how many years is a United States Senator elected - that is, how many years are there in one...","QuestionID":"QID19","QuestionText":"For how many years is a United States Senator elected - that is, how many years are there in one full term of o\ufb03ce for a U.S. Senator?","QuestionText_Unsafe":"For how many years is a United States Senator elected - that is, how many years are there in one full term of o\ufb03ce for a U.S. Senator?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"Enter intervention number","TertiaryAttribute":null,"Payload":{"QuestionText":"Enter intervention number","DefaultChoices":false,"DataExportTag":"provide_int","QuestionType":"TE","Selector":"SL","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Enter intervention number","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID2"}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID20","SecondaryAttribute":"How many times can an individual be elected President of the United States under current laws?","TertiaryAttribute":null,"Payload":{"AnalyzeChoices":{"5":"on"},"ChoiceOrder":[1,2,3,4,5],"Choices":{"1":{"Display":"Once"},"2":{"Display":"Twice"},"3":{"Display":"Four times"},"4":{"Display":"Unlimited number of terms"},"5":{"Display":"Don't know"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"pk2","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"How many times can an individual be elected President of the United States under current laws?","QuestionID":"QID20","QuestionText":"How many times can an individual be elected President of the United States under current laws?","QuestionText_Unsafe":"How many times can an individual be elected President of the United States under current laws?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}}}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID21","SecondaryAttribute":"Who is currently the Prime Minister of the United Kingdom?","TertiaryAttribute":null,"Payload":{"AnalyzeChoices":{"6":"on"},"ChoiceOrder":[1,2,3,4,5,6],"Choices":{"1":{"Display":"Richi Sunak"},"2":{"Display":"Boris Johnson"},"3":{"Display":"David Cameron"},"4":{"Display":"Theresa May"},"5":{"Display":"Margaret Thatcher"},"6":{"Display":"Don't know"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"pk3","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":7,"QuestionDescription":"Who is currently the Prime Minister of the United Kingdom?","QuestionID":"QID21","QuestionText":"Who is currently the Prime Minister of the United Kingdom?","QuestionText_Unsafe":"Who is currently the Prime Minister of the United Kingdom?","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"RequestResponse","ForceResponseType":"RequestResponse","Type":"None"}},"Randomization":{"Advanced":null,"Type":"All","TotalRandSubset":""}}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID22","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q16","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":28,"QuestionDescription":"Timing","QuestionID":"QID22","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer"}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID23","SecondaryAttribute":"COLUMBIA UNIVERSITY Interventions to Reduce Affective Polarization Protocol #: AAAU3946 Investiga...","TertiaryAttribute":null,"Payload":{"QuestionText":"COLUMBIA UNIVERSITY\n<br><br>Interventions to Reduce Affective Polarization\n<br>Protocol #: AAAU3946\n<br>Investigators: Dr. Yamil Velez (Columbia University)\n<br><br>Investigators' statement <br><br>We are asking you to be in a research study. The purpose of this\nconsent form is to give you the information you will need to help you decide whether or not to be\nin the study. Please read the form carefully. You may ask questions about the purpose of the\nresearch, what we would ask you to do, the possible risks and benefits, your rights as a\nvolunteer, and anything else about the research or this form that is not clear. When all your\nquestions have been answered, you can decide if you want to be in the study or not. This\nprocess is called \u2018informed consent.\u2019\n<br><br>PURPOSE <br><br>The purpose of this study is to examine how the presentation of information affects\nyour opinion about political parties and electoral systems.\nBENEFITS There are no personal benefits to participating in this study. However, this study\ncould produce positive benefits for society by increasing our knowledge about how critical\ninformation should be communicated to the public.\n<br><br>PROCEDURES Throughout the study, we will ask you your opinions regarding government and\npublic officials. You may be asked to read 1 short vignette that is 2-3 paragraphs long or watch\na brief video (&lt; 3 min) and answer questions about political groups. The study will conclude with\na demographic battery.\n<br><br>RISKS, STRESS, OR DISCOMFORT Emotional stress is a potential risk.\n<br><br>OTHER INFORMATION None of the data will be linked to you personally, as we will not collect\nidentifying information. You may refuse to participate or withdraw from the study at any time\nwithout penalty or loss of benefits to which you are otherwise entitled.\n<br><br>PARTICIPATION Participation in research is entirely voluntary. You may refuse to participate\nor withdraw from participation at any time without jeopardizing your employment, student status\nor any other entitlements. The investigator may withdraw you at his\/her professional discretion.\n<br><br>PRIVATE INFORMATION Any information derived from this research project that personally\nidentifies you will not be voluntarily released or disclosed without your separate consent, except\nas specifically required by law. CU Human Research Protection Office may obtain access to the\ndata collected for this study. No private information or identifiers will be collected.\n<br><br>COMPENSATION You will be compensated by Lucid. <br><br>CONTACT INFORMATION If at any time you have questions regarding the research or your\nparticipation, you should contact the principal investigator, Yamil Velez, who will answer all\nquestions. His telephone number is (212) 8514274. You should also contact the investigator or a\nmember of the research staff if you have any concerns or complaints about the research. If at any\ntime you have comments regarding the conduct of this research or questions about your rights as\na research participant, you should contact the Institutional Review Board (IRB) Administrator at\n(212) 305-5883 or email them at askirb@columbia.edu.\n<br><br>PARTICIPANT\u2019S STATEMENT I have read the above purpose of the study, and understand\nmy role in participating in the research. I volunteer to take part in this research. I have had a\nchance to ask questions. If I have questions later, about the research, I can ask the investigator\nlisted above. I understand that I may refuse to participate or withdraw from participation at any\ntime without jeopardizing my employment, student status or other rights to which I am entitled.\nThe investigator may withdraw me at his\/her professional discretion. If I have questions about\nmy rights as a research participant, I can call the Institutional Review Board office at (212)\n3055883 or email them at askirb@columbia.edu. I certify that I am 18 years of age or older and\nfreely give my consent to participate in this study. I will either print the form or write down the\nresearcher's contact information before proceeding to the study in case I have any questions.\nPlease click Next to continue if you agree with these terms.&nbsp;","DefaultChoices":false,"DataExportTag":"irb","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"COLUMBIA UNIVERSITY Interventions to Reduce Affective Polarization Protocol #: AAAU3946 Investiga...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID23","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID24","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q24","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID24"}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID25","SecondaryAttribute":"Please verify you are not a robot.","TertiaryAttribute":null,"Payload":{"QuestionText":"Please verify you are not a robot.","DefaultChoices":false,"DataExportTag":"captcha","QuestionType":"Captcha","Selector":"V2","Configuration":{"QuestionDescriptionOption":"UseText","Align":"left","Theme":"light"},"QuestionDescription":"Please verify you are not a robot.","GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID25"}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Please click here.","TertiaryAttribute":null,"Payload":{"QuestionText":"<a href=\"https:\/\/chat.ourlocalcommunities.com\/?id=1\" target=\"_blank\">Please click here.<\/a>","DefaultChoices":false,"DataExportTag":"Q26","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please click here.","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID26","DataVisibility":{"Private":false,"Hidden":false}}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID27","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"<a target=\"_blank\" href=\"http:\/\/www.google.com\" rel=\"noopener\">Click to write the question text<\/a>","DefaultChoices":false,"DataExportTag":"Q27","QuestionID":"QID27","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute":"QID28","SecondaryAttribute":"We would like you to rate them using something we call the feeling thermometer. Ratings between 5...","TertiaryAttribute":null,"Payload":{"QuestionText":"We would like you to rate them using something we call the feeling thermometer.\nRatings between 50 degrees and 100 degrees mean that you feel favorable and warm toward them.\nRatings between 0 degrees and 50 degrees mean that you don't feel favorable toward them and that you\ndon't care too much for them.&nbsp;You would rate them at the 50 degree mark if you don't feel particularly warm or cold toward them.","DefaultChoices":false,"QuestionType":"Slider","Selector":"HSLIDER","Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0,"2":0}},"QuestionDescription":"We would like you to rate them using something we call the feeling thermometer. Ratings between 5...","Choices":{"1":{"Display":"How would you rate Republicans?"},"2":{"Display":"How would you rate Democrats?"}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"Labels":[],"DataVisibility":{"Private":false,"Hidden":false},"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"All"},"QuestionText_Unsafe":"We would like you to rate them using something we call the feeling thermometer.\nRatings between 50 degrees and 100 degrees mean that you feel favorable and warm toward them.\nRatings between 0 degrees and 50 degrees mean that you don't feel favorable toward them and that you\ndon't care too much for them.&nbsp;You would rate them at the 50 degree mark if you don't feel particularly warm or cold toward them.","DataExportTag":"post_ap_scores","QuestionID":"QID28"}},{"SurveyID":"SV_3aSvLQVIfvVTHsa","Element":"SQ","PrimaryAttribute"