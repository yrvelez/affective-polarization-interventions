{
 "id": "generalizability_conditional",
 "kind": "boundary",
 "title": "Perception gap video across partisanship and sample",
 "rationale": "The Perception gap video was the only arm with p<0.05 (-2.3 points, 95% CI [-4.3, -0.4], p=0.019, uncorrected) in a single Lucid panel with only partisans, and heterogeneity tests were too imprecise to interpret. This design replicates it in two sample sources across Democrats, Republicans and independent leaners with pre-measures.",
 "contribution": "Tests whether the Perception gap video effect on the feeling thermometer and undemocratic-practices support holds across party, partisan strength and sample source.",
 "limitations": [
  "Second panel may differ in attention and demographics, confounding sample with mode",
  "Outcomes measured immediately after exposure; durability unknown",
  "Independent leaners are a heterogeneous group and the in-party/out-party measure depends on leaning",
  "Subgroup and interaction tests remain underpowered unless the target n is reached"
 ],
 "design": {
  "title": "Perception gap video vs control across party and sample",
  "overview": "Respondents from a Lucid panel and a second panel are stratified by party (Democrat, Republican, independent leaner). After consent and pre-measures, they are randomized to the Perception gap video or a control, then complete the feeling thermometer and undemocratic-practices items. Effects are estimated by party and sample, with interaction tests.",
  "hypothesis": "The Perception gap video lowers affective polarization relative to control, and the effect does not differ materially by party, partisan strength or sample source.",
  "primaryOutcome": "Affective polarization: in-party minus out-party feeling thermometer after treatment; secondary: mean support for undemocratic practices.",
  "comparison": "Perception gap video vs control, with treatment x party and treatment x sample interactions, controlling for pre-treatment measures.",
  "population": "US adults who identify with or lean toward a party, recruited from Lucid and a second panel, with quotas by party.",
