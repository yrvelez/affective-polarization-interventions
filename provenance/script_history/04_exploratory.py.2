"""Exploratory analyses for the Affective Polarization survey experiment."""
import importlib.util, pathlib
_spec = importlib.util.spec_from_file_location('reg', pathlib.Path(__file__).with_name('03_registered.py'))
reg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(reg)

import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

# ── Load data ──────────────────────────────────────────────────────────────────
df = pd.read_csv('data/clean.csv')
for c in ['post_ap', 'post_udp', 'pre_ap', 'pre_udp', 'ipw_weight']:
    df[c] = pd.to_numeric(df[c], errors='coerce')

if 'arm_code' not in df.columns:
    df['arm_code'] = df['arm']

pathlib.Path('results').mkdir(exist_ok=True)
pathlib.Path('figures').mkdir(exist_ok=True)

def style_ax(ax):
    ax.spines['top'].set_visible(False)
    ax.spines['right'].set_visible(False)
    ax.spines['left'].set_visible(False)
    ax.spines['bottom'].set_visible(True)
    ax.grid(False)
    ax.tick_params(left=False)

INK = '#1a1a1a'

# ── Debug: understand the registered helpers ──────────────────────────────────
h1 = reg.HYPOTHESES[0]
print("H1 keys:", list(h1.keys()))
print("H1 estimator:", h1['estimator'])
print("H1 outcome:", h1.get('outcome'))

# Try building formula on full data first to see term names
outcome = 'post_ap'
est = h1['estimator']
covariates = ['pre_ap']
d_full = df.dropna(subset=[outcome, 'pre_ap', 'ipw_weight']).copy()
formula, d2 = reg.build_formula(outcome, est, covariates, d_full)
print("Formula:", formula)
print("d2 columns:", list(d2.columns))
print("d2 arm_code values:", sorted(d2['arm_code'].unique())[:5], "...")
res = reg.fit(d2, formula, est)
print("res.params index (first 10):", list(res.params.index[:10]))
print("res.params index (all):", list(res.params.index))
