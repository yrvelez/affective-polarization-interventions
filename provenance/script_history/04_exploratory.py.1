import importlib.util, pathlib
import pandas as pd
import numpy as np

_spec = importlib.util.spec_from_file_location('reg', pathlib.Path(__file__).with_name('03_registered.py'))
reg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(reg)

ROOT = pathlib.Path(__file__).resolve().parent.parent
RES = ROOT / 'results'
RES.mkdir(exist_ok=True)

d = pd.read_csv(ROOT / 'data' / 'clean.csv')
for c in ['pre_ap', 'post_ap', 'pre_udp', 'post_udp', 'Finished', 'ipw_weight']:
    if c in d.columns:
        d[c] = pd.to_numeric(d[c], errors='coerce')

H1 = reg.HYPOTHESES[0]
H2 = reg.HYPOTHESES[1]

# E1: robustness of the planned H1 and H2 estimates to restricting to completed surveys.
# Rationale: partial completers (Finished == 0) may differ in attention, so the planned estimates are re-fit on completers only to check stability.
rows = []
for hid, h in [('H1', H1), ('H2', H2)]:
    orig = reg.reestimate(h, d)
    sub = d[d['Finished'] == 1]
    re = reg.reestimate(h, sub)
    o = orig.assign(analysis=hid, sample='planned_full')
    r = re.assign(analysis=hid, sample='completers_only')
    rows.append(o)
    rows.append(r)
e1 = pd.concat(rows, ignore_index=True)
e1.to_csv(RES / 'E1_completers_robustness.csv', index=False)

wide = e1.pivot_table(index=['analysis', 'arm'], columns='sample',
                      values=['estimate', 'std_error', 'n'], aggfunc='first')
wide.columns = [f'{a}_{b}' for a, b in wide.columns]
wide = wide.reset_index()
wide.to_csv(RES / 'E1_completers_robustness.csv', index=False)
e1_ok = True
ratio = (wide['std_error_completers_only'] / wide['std_error_planned_full'])
n_ratio = wide['n_completers_only'] / wide['n_planned_full']
flag = ((ratio > 2) | (ratio < 0.5)) & ((1 - n_ratio).abs() < 0.10)
if flag.any():
    e1_ok = False
dev = (wide['estimate_completers_only'] - wide['estimate_planned_full']).abs()
sig_full = e1[(e1['sample'] == 'planned_full')].groupby('analysis')['p_value'].apply(lambda s: int((s < 0.05).sum()))
sig_sub = e1[(e1['sample'] == 'completers_only')].groupby('analysis')['p_value'].apply(lambda s: int((s < 0.05).sum()))
print(f"E1 Completers-only re-fit of planned tests: max |estimate change| = {dev.max():.2f} points/scale units; "
      f"arms with p<0.05 planned vs completers: H1 {sig_full.get('H1', 0)} vs {sig_sub.get('H1', 0)}, "
      f"H2 {sig_full.get('H2', 0)} vs {sig_sub.get('H2', 0)} (of 32 arm contrasts each)")

# E2: heterogeneity of H1 effects by partisan group (Democrat vs Republican), a dimension the plan did not register.
# Rationale: the planned pooled test may hide opposite responses among Democrats and Republicans, so arm effects are compared across the two groups.
d['dem'] = (d['partisan'].astype(str).str.strip() == 'Democrat').astype(int)
m = reg.reestimate(H1, d, moderator='dem')
m.to_csv(RES / 'E2_partisan_heterogeneity.csv', index=False)
pcol = 'p_value'
n_int = len(m)
n_sig = int((m[pcol] < 0.05).sum())
print(f"E2 Arm x partisan (Democrat vs Republican) interactions on post_ap: {n_sig} of {n_int} interaction rows have p<0.05 "
      f"(median interaction estimate {m['estimate'].median():.2f} points)")

# E3 (summary only, no extra analysis): nothing more.
