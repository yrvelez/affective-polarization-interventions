import importlib.util, pathlib
import pandas as pd
import numpy as np

_spec = importlib.util.spec_from_file_location('reg', pathlib.Path(__file__).with_name('03_registered.py'))
reg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(reg)

ROOT = pathlib.Path(__file__).resolve().parent.parent
RES = ROOT / 'results'
RES.mkdir(exist_ok=True)

clean = pd.read_csv(ROOT / 'data' / 'clean.csv', low_memory=False)
for c in ['Finished', 'pid3', 'interest']:
    clean[c] = pd.to_numeric(clean[c], errors='coerce')

H1 = reg.HYPOTHESES[0]


def sig_count(df):
    p = pd.to_numeric(df['p_value'], errors='coerce')
    return int((p < 0.05).sum()), int(p.notna().sum())


# E1: robustness to restricting to fully completed responses (Finished == 1).
# Rationale: the registered sample includes partial responses; completers-only is the most common alternative exclusion.
orig = reg.reestimate(H1, clean)
sub = clean[clean['Finished'] == 1]
alt = reg.reestimate(H1, sub)
m = orig[['arm', 'estimate', 'std_error', 'n']].merge(
    alt[['arm', 'estimate', 'std_error', 'n']], on='arm', suffixes=('_planned', '_completers'))
m.to_csv(RES / 'E1_completers_only.csv', index=False)
n_ratio = len(sub) / len(clean)
se_ratio = (m['std_error_completers'] / m['std_error_planned']).abs()
print(f"E1 Completers-only robustness of planned H1: {len(m)} arms, {int(((m['estimate_completers'] - m['estimate_planned']).abs()<0.5).sum())} within 0.5 points of planned estimate; SE ratio range {se_ratio.min():.2f}-{se_ratio.max():.2f} with sample at {n_ratio:.0%} of planned (flagged if SE changes >2x with <10% sample change)")
if ((se_ratio > 2) & (abs(1 - n_ratio) < 0.10)).any():
    print('E1 dropped by rule')

# E2: heterogeneity of planned H1 by Democratic identification (pid3 == 2) vs others.
clean['is_dem'] = (clean['pid3'] == 2).astype(int)
het = reg.reestimate(H1, clean, moderator='is_dem')
het.to_csv(RES / 'E2_dem_heterogeneity.csv', index=False)
s, n = sig_count(het)
print(f"E2 Heterogeneity of planned H1 by Democratic identification: {s} of {n} arm-by-group interaction tests significant at p<0.05 (planned H1 family of 32 interventions)")

# E3: heterogeneity by political interest (interest >= 4 vs below), the study's own item.
clean['high_interest'] = (clean['interest'] >= 4).astype(int)
het2 = reg.reestimate(H1, clean, moderator='high_interest')
het2.to_csv(RES / 'E3_interest_heterogeneity.csv', index=False)
s2, n2 = sig_count(het2)
print(f"E3 Heterogeneity of planned H1 by high political interest: {s2} of {n2} arm-by-group interaction tests significant at p<0.05")
